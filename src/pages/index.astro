---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import Contact from '~/components/widgets/Contact.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Image } from 'astro:assets';
import { getAsset } from '~/utils/permalinks';
import teamMichael from '~/assets/images/mpb/team-michael.png';
import teamAudrey from '~/assets/images/mpb/team-audrey.png';
import teamIfeanyi from '~/assets/images/mpb/team-ifeanyi.png';
import teamBetelihem from '~/assets/images/mpb/team-betelihem.png';

const metadata = {
  title: 'MPowerBoards — Revolutionizing Power Grid Education and Research',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Explore the boards', href: '#boards' },
      { text: 'Watch our story', href: '#demo' },
    ]}
    image={{ src: '~/assets/images/mpb/board-usa1.png', alt: 'MPowerBoards Power Systems Education Board', width: 792, height: 815 }}
  >
    <Fragment slot="title">
      Revolutionizing <span class="text-accent dark:text-white">Power Grid</span> Education and Research
    </Fragment>

    <Fragment slot="subtitle">
      MPowerBoards transforms real power-grid simulations into interactive physical boards using LEDs, embedded
      electronics, and real-time visualization. Students don't just calculate power flow — they watch it happen.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="The problem:"
    description="Power systems are hard to visualize. Software and equations alone aren't enough, and existing hardware is expensive or inaccessible — so thousands of engineering students learn the grid without ever truly seeing it work."
  />

  <!-- Features Widget *************** -->

  <Features
    tagline="Interactive Physical Visualization"
    title="Learning the grid, by watching it run"
    subtitle="Three flagship boards for classrooms, education, and research — from basic concepts to real grid operations."
    columns={3}
    items={[
      {
        title: 'Real-time simulations',
        description: 'Power flow computed live and displayed on-board as students change conditions in real time.',
        icon: 'tabler:activity',
      },
      {
        title: 'Embedded electronics',
        description: 'Custom PCBs with onboard microcontrollers, displays, and LEDs model each grid in hardware.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Modeling complex concepts',
        description: 'From Optimal Power Flow to Locational Marginal Pricing, made tangible on real board layouts.',
        icon: 'tabler:topology-star-3',
      },
    ]}
  />

  <!-- Boards ************************ -->

  <Content
    id="boards"
    tagline="Flagship Board"
    title="USA1 — Power Systems Education Board"
    items={[
      { title: 'PJM-5 and IEEE-14 test cases', description: 'Switch between standard teaching cases with the Case Select button.' },
      { title: 'OPF, LMP, and SCOPF', description: 'Run Optimal Power Flow, Locational Marginal Pricing, and Security Constrained OPF on demand.' },
      { title: 'DC and AC based modes', description: 'Toggle between DC-based and AC-based power flow formulations.' },
      { title: 'Built with Georgia Tech', description: 'Developed with the AI Institute for Advances in Optimization.' },
    ]}
    image={{ src: '~/assets/images/mpb/board-usa1.png', alt: 'MPowerBoards USA1 Power Systems Education Board', width: 792, height: 815 }}
  >
    <Fragment slot="content">
      Our general-purpose classroom board for teaching core power systems concepts on familiar U.S. test networks.
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    tagline="Flagship Board"
    title="Gh1 — Ghana Electric Grid Simulation"
    items={[
      { title: 'A real, synthetic African grid', description: 'Modeled on the paper "Developing a Synthetic Electric Grid in Africa: A Case Study in Ghana."' },
      { title: 'DC OPF and SC OPF (N-1)', description: 'Explore substation-level results under normal and contingency conditions.' },
      { title: 'Substation selection & results display', description: 'Dedicated OLED panels for picking a substation and reading live results.' },
      { title: 'Built with Georgia Tech GOAL', description: 'Developed with the Grid Optimization & Algorithms Lab, for classrooms studying grids beyond the U.S.' },
    ]}
    image={{ src: '~/assets/images/mpb/board-gh1.png', alt: 'MPowerBoards Gh1 Ghana Electric Grid Simulation board', width: 792, height: 815 }}
  >
    <Fragment slot="content">
      Built for a Georgia Tech professor who wanted a realistic board of an African grid for classroom use.
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline="Flagship Board"
    title="ISO1 — Interconnections"
    items={[
      { title: 'Four North American interconnections', description: 'Western, ERCOT, Eastern, and Quebec, all on one board.' },
      { title: 'Real Independent System Operators', description: 'CAISO, ERCOT, MISO, New York ISO, PJM, SPP, and Hydro Québec.' },
      { title: 'Live ISO data selection', description: 'Data Selection and ISO Selection controls let you browse each region.' },
      { title: 'Designed to be displayed', description: 'A decorative board built for a Georgia Tech professor\'s office.' },
    ]}
    image={{ src: '~/assets/images/mpb/board-iso1.png', alt: 'MPowerBoards ISO1 Interconnections board', width: 792, height: 815 }}
  >
    <Fragment slot="content">
      A showpiece board that maps the grid's real operating boundaries across North America.
    </Fragment>
  </Content>

  <!-- Demo Video ******************** -->

  <WidgetWrapper id="demo" containerClass="max-w-5xl mx-auto">
    <Headline
      tagline="Introducing MPowerBoards"
      title="Meet the team and the mission"
      subtitle="A short introduction to MPowerBoards — who we are and what we're building."
    />
    <video
      class="w-full rounded-lg shadow-lg bg-black"
      controls
      preload="metadata"
      poster={getAsset('/images/mpb/overview-poster.jpg')}
    >
      <source src={getAsset('/video/mpowerboards-demo.mp4')} type="video/mp4" />
    </video>
  </WidgetWrapper>

  <!-- Stats Widget ****************** -->

  <Stats
    id="about"
    tagline="Progress & Validation"
    title="Already in classrooms and labs"
    stats={[
      { title: 'Undergrad / HS students', amount: '15+' },
      { title: 'K-12 teachers & students', amount: '10+' },
      { title: 'Professors & PhD researchers', amount: '8+' },
    ]}
  />

  <!-- About / Mission **************** -->

  <Content
    isAfterContent
    items={[
      { title: 'Working prototypes', description: 'Built, tested, and demoed in real classrooms.' },
      { title: 'Georgia Tech faculty', description: 'Developed alongside GOAL and the AI Institute for Advances in Optimization.' },
      { title: 'AI for Power Systems Institute', description: 'Partnered for outreach demos with high schools and undergraduates.' },
    ]}
    image={{ src: '~/assets/images/mpb/overview.jpg', alt: 'MPowerBoards collage of all three flagship boards', width: 1200, height: 675 }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Our mission</h3>
      Our mission is to make power systems education visual, interactive, and accessible. We'd love to connect with
      educators, researchers, and investors.
    </Fragment>
  </Content>

  <!-- Team **************************** -->

  <WidgetWrapper id="team" containerClass="max-w-6xl mx-auto">
    <Headline tagline="Who's behind it" title="Meet the team" />
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <Image src={teamMichael} alt="Michael A. Boateng" width={500} height={308} class="w-full h-auto rounded-lg" />
      <Image src={teamAudrey} alt="Audrey H. Vu" width={500} height={308} class="w-full h-auto rounded-lg" />
      <Image src={teamIfeanyi} alt="Ifeanyi D. Sorokwu" width={500} height={308} class="w-full h-auto rounded-lg" />
      <Image src={teamBetelihem} alt="Betelihem K. Ashebo" width={500} height={308} class="w-full h-auto rounded-lg" />
    </div>
  </WidgetWrapper>

  <!-- Contact Widget ****************** -->

  <Contact
    id="contact"
    title="Let's connect"
    subtitle="Educator, researcher, or investor — we'd love to hear from you."
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' },
      { type: 'text', name: 'organization', label: 'Organization' },
    ]}
    textarea={{ label: 'Message' }}
    button="Send message"
    description="We typically respond within a few business days."
  />
</Layout>
